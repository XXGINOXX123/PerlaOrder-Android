# Copia este archivo como .env (no se versiona) o define las variables en la
# configuración de ejecución del IDE.

# Interfaz y puerto. 0.0.0.0 es necesario para que las tablets del local lleguen al servidor.
PERLA_HOST=0.0.0.0
PERLA_PORT=8080

# Archivo SQLite del servidor.
PERLA_DB_PATH=data/perlaorder.db

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
# Si se omite, el servidor crea uno aleatorio en cada arranque (las sesiones no sobreviven al reinicio).
PERLA_JWT_SECRET=

# Administrador inicial; solo se usa cuando la tabla usuarios está vacía.
# Si se omite la contraseña, se genera una aleatoria y se muestra una única vez en el log.
PERLA_ADMIN_USER=admin
PERLA_ADMIN_PASSWORD=

# Número de mesas del local (valida el campo "mesa" de los pedidos).
PERLA_MESAS=20
